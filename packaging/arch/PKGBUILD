# Maintainer: Fancy Butler
# Build from a local checkout:  cd packaging/arch && makepkg -si
pkgname=pushbridge
pkgver=0.2.2
pkgrel=1
pkgdesc="Ableton Push 1 front end for Linux: scales, drums, knobs, clock, Live hand-off"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'alsa-lib')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=()

_root="$(realpath "$startdir/../..")"

build() {
  cd "$_root"
  python -m build --wheel --no-isolation --outdir "$srcdir/dist"
}

package() {
  cd "$_root"
  python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
  install -Dm644 packaging/pushbridge.desktop "$pkgdir/usr/share/applications/pushbridge.desktop"
  install -Dm644 packaging/pushbridge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/pushbridge.svg"
  for n in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/pushbridge-$n.png" "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/pushbridge.png"
  done
  install -Dm644 packaging/pushbridge.service "$pkgdir/usr/lib/systemd/user/pushbridge.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
